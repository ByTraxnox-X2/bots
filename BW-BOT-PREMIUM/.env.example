# ===== Identidad =====
# Número del bot (con código de país, sin +). Solo se usa para pedir el Pairing Code
# la primera vez; después la identidad se toma dinámicamente de la sesión conectada.
BOT_PHONE=
OWNER_NUMBER=593990192338
BOT_PREFIX=.
TZ_BOT=America/Guayaquil

# ===== Free Fire (APIs configurables, separadas por coma) =====
FF_API_URLS=
FF_API_KEY=
FF_DEFAULT_REGION=
FF_REGIONS=
# Cada URL es una plantilla. Marcadores: {uid} {region} {key}. Si no usa {uid}, se añade ?uid=... al final.
# Las URLs se separan con coma, así que una URL no puede contener comas (codifícalas como %2C).
# Para probar tus APIs sin iniciar el bot: npm run ff-probe -- UID [REGION] --raw
# La clave FF_API_KEY SOLO se envía a las URLs donde escribas {key}. Ejemplo (inventado, usa tu proveedor real):
#   FF_API_URLS=https://api.tu-proveedor.com/player?uid={uid}&region={region}&key={key},https://respaldo.ejemplo/ff/{uid}
FF_API_TIMEOUT=8000
FF_CACHE_TTL=300
FF_API_MAX_CONCURRENT=4
# Reintentos acotados ante fallos transitorios (timeout, red, 5xx) con espera exponencial. Vacío = 1 para proveedores
# FF_PROVIDER_n y 0 para plantillas FF_API_URLS. Los 401/403/404/429 nunca se reintentan.
FF_API_RETRIES=
FF_API_BACKOFF_MS=300
# Fusión segura: si el primer proveedor no entrega nick/nivel/exp/likes/rango, se consultan hasta N más SOLO para
# completar los campos que faltan (nunca se pisa un dato ni se inventa).
FF_MERGE_PROVIDERS=true
FF_MERGE_MAX_EXTRA=2
# UID de prueba para "apistatus probar" (health check manual de cada proveedor). Vacío = sin sonda.
FF_HEALTH_UID=

# ----- Proveedores nombrados de Free Fire (multi-API con fallback por prioridad) -----
# Elige y ordena con una lista: providerN usa FF_PROVIDER_N_*, y un nombre de preset (hlgaming, ffcommunity, jinix,
# gameskinbo) usa FF_PROVIDER_<NOMBRE>_*. Sin lista, se usan todos los FF_PROVIDER_n_* definidos, por número.
#   FREEFIRE_PROVIDERS=provider1,provider2,provider3
# Por proveedor (n = 1, 2, 3…):
#   FF_PROVIDER_n_TYPE=generic|hlgaming|ffcommunity|jinix|gameskinbo   (generic = plantilla {uid} {region} {key})
#   FF_PROVIDER_n_URL=       (generic: plantilla completa; preset: URL base, opcional)
#   FF_PROVIDER_n_KEY=       (hlgaming: USERUID:APIKEY; ffcommunity/gameskinbo: clave; jinix: sin clave)
#   FF_PROVIDER_n_ENABLED=true|false   FF_PROVIDER_n_PRIORITY=1..1000 (menor = antes)
#   FF_PROVIDER_n_TIMEOUT=8000   FF_PROVIDER_n_REGIONS=br,us,sg   FF_PROVIDER_n_RATE_LIMIT=consultas/min (0 = sin límite propio)
#   FF_PROVIDER_n_RETRIES=1   FF_PROVIDER_n_NAME=etiqueta   FF_PROVIDER_n_AUTH_HEADER=x-api-key (solo generic)
# Ejemplo (sin claves reales):
#   FF_PROVIDER_1_TYPE=ffcommunity
#   FF_PROVIDER_1_KEY=tu-clave
#   FF_PROVIDER_2_TYPE=jinix
FREEFIRE_PROVIDERS=
FF_PROVIDER_1_TYPE=
FF_PROVIDER_1_URL=
FF_PROVIDER_1_KEY=
FF_PROVIDER_2_TYPE=
FF_PROVIDER_2_URL=
FF_PROVIDER_2_KEY=
FF_PROVIDER_3_TYPE=
FF_PROVIDER_3_URL=
FF_PROVIDER_3_KEY=

# ===== Clanes (APIs configurables, separadas por coma) =====
# Plantillas con {id} (ID del clan), {region} (opcional) y {key}. Si no hay {id}, se añade ?id=... al final.
# CLAN_API_KEY SOLO se envía a las URLs que contienen {key} (no se reutiliza FF_API_KEY).
# Sin CLAN_API_URLS no se puede verificar ningún clan (nunca se inventan datos).
# Prueba tus APIs: npm run clan-probe -- IDCLAN [REGION] --raw
CLAN_API_URLS=
CLAN_API_KEY=
CLAN_DEFAULT_REGION=
CLAN_REGIONS=
CLAN_API_TIMEOUT=8000
CLAN_CACHE_TTL=600
CLAN_API_MAX_CONCURRENT=4
CLAN_REFRESH_HOURS=6
CLAN_API_RETRIES=
CLAN_API_BACKOFF_MS=300
CLAN_MERGE_PROVIDERS=true
CLAN_MERGE_MAX_EXTRA=2
# ID de clan de prueba para "apistatus probar". Vacío = sin sonda.
CLAN_HEALTH_ID=
# Proveedores nombrados de clanes: mismas variables que FF_PROVIDER_n_* pero con prefijo CLAN_PROVIDER_n_*
# (presets con clan: hlgaming, jinix). Lista: CLAN_PROVIDERS=provider1,provider2
CLAN_PROVIDERS=
CLAN_PROVIDER_1_TYPE=
CLAN_PROVIDER_1_URL=
CLAN_PROVIDER_1_KEY=
CLAN_PROVIDER_2_TYPE=
CLAN_PROVIDER_2_URL=
CLAN_PROVIDER_2_KEY=

# ===== GDC (guerra de clanes) =====
# La hora, el recordatorio, el honor y las placas se configuran POR CLAN con .gdc (no hay valores globales).
# Vigencia de una invitación a escuadra (minutos).
GDC_INVITE_TTL_MINUTES=10
# Máximo de menciones en los avisos automáticos (participantes reales del grupo; 0 = no mencionar).
GDC_MAX_MENTIONS=200
# Una escuadra sin actividad durante estas horas se archiva sola (evita escuadras olvidadas).
GDC_SQUAD_TTL_HOURS=36
# Cantidad de GDC finalizadas que se conservan en el historial de cada grupo.
GDC_HISTORY_KEEP=60

# ===== Equipos y partidas (2v2 / 4v4 / 6v6) =====
# Minutos de vigencia de una invitación a un equipo.
TEAM_INVITE_TTL_MINUTES=60
# Cuántos equipos activos puede capitanear una misma persona.
TEAM_MAX_PER_CAPTAIN=3
# Una partida que no llegó a iniciarse se cancela sola pasadas estas horas.
MATCH_TTL_HOURS=24
# Partidas finalizadas/canceladas que se conservan en la base de datos.
MATCH_HISTORY_KEEP=300

# ===== Scrims =====
# Minutos antes de la hora en que se abre el check-in, minutos del recordatorio y horas tras las que un scrim sin terminar vence.
SCRIM_CHECKIN_MINUTES=30
SCRIM_REMIND_MINUTES=15
SCRIM_EXPIRE_HOURS=3

# Broadcast del OWNER: pausa entre grupos (ms) para no saturar WhatsApp
BROADCAST_DELAY_MS=1500

# ELO / temporadas (Fase 8)
ELO_K=32
ELO_K_PROVISIONAL=48
ELO_PROVISIONAL_MATCHES=10
ELO_MAX_PAIR_PER_DAY=4
ELO_SEASON_SOFT_RESET_PERCENT=50
ELO_SEASON_REWARDS=300,200,100

# ===== Juegos interactivos (monedas virtuales) =====
# Premio por ganar un juego sin apuestas y tope diario de monedas por premios (anti-farmeo). 0 = sin premio.
GAME_PRIZE_COINS=50
GAME_PRIZE_XP=10
GAME_DAILY_COIN_CAP=500
# Apuesta máxima en juegos con apuesta (ppt, dados, coinflip, duelo).
GAME_MAX_BET=1000
# Segundos: espera para unirse a un juego multijugador, duración de una ronda y de una pregunta.
GAME_LOBBY_SECONDS=60
GAME_ROUND_SECONDS=30
GAME_QUESTION_SECONDS=30

# ===== Play / multimedia =====
PLAY_API_URLS=
PLAY_API_KEYS=
PLAY_SEARCH_URLS=
PLAY_DOWNLOAD_URLS=
MAX_PLAY_QUEUE=10
MAX_PLAY_CONCURRENT=2
MAX_PLAY_FILE_SIZE=67108864
PLAY_TIMEOUT=60000
PLAY_CACHE_TTL=3600
# Proveedores multimedia nombrados (plantillas con {query} {type} {limit} {url} {id} {key}). Con {query} buscan;
# con {url} o {id} descargan. La clave solo se envía a plantillas con {key}. Lista: MEDIA_PROVIDERS=provider1,provider2
# Variables por proveedor: MEDIA_PROVIDER_n_URL / _KEY / _ENABLED / _PRIORITY / _TIMEOUT / _NAME
MEDIA_PROVIDERS=
MEDIA_PROVIDER_1_URL=
MEDIA_PROVIDER_1_KEY=
MEDIA_PROVIDER_2_URL=
MEDIA_PROVIDER_2_KEY=
# Texto de búsqueda de prueba para "apistatus probar" en medios. Vacío = sin sonda.
MEDIA_HEALTH_QUERY=
# Caché de archivos en disco (MB; 0 = sin caché), descargas simultáneas por usuario, vigencia de la selección de .play (s),
# número de resultados y duración máxima permitida (s; 0 = sin límite).
PLAY_FILE_CACHE_MB=200
MAX_PLAY_PER_USER=1
PLAY_CONTEXT_TTL=300
PLAY_RESULTS=5
PLAY_MAX_DURATION=1800

# ===== Botones y respuestas numeradas =====
# text (por defecto): listas numeradas (.1 .2 …) compatibles con todo. native: además intenta botones nativos de WhatsApp.
UI_BUTTONS=text
# Segundos que una lista/botón sigue siendo válido.
UI_BUTTON_TTL=300

# ===== Almacenamiento =====
DATABASE_PATH=
DATA_DIR=data
SESSION_DIR=data/session
BACKUP_DIR=data/backups
LOG_DIR=data/logs
TMP_DIR=data/tmp
DB_SAVE_DEBOUNCE_MS=1500
DB_BACKUP_MINUTES=360
DB_BACKUP_KEEP=10

# ===== Logs =====
# debug | info | warn | error
LOG_LEVEL=info
LOG_TO_FILE=true

# ===== Reconexión de WhatsApp =====
RECONNECT_BASE_MS=2000
RECONNECT_MAX_MS=120000
# 0 = sin límite de intentos (el retardo sigue acotado por RECONNECT_MAX_MS)
RECONNECT_MAX_ATTEMPTS=0
# Mensajes más antiguos que esto (segundos) se ignoran, para no ejecutar comandos atrasados al reconectar.
MAX_MESSAGE_AGE_SECONDS=120

# ===== Health check (monitoreo) =====
# 0 = desactivado. Endpoints: /health (vivo), /ready (WhatsApp conectado), /status (JSON).
# Escucha solo en localhost por defecto. En Docker ya viene configurado (3000 / 0.0.0.0).
HEALTH_PORT=0
HEALTH_HOST=127.0.0.1

# ===== Scheduler (GDC, torneos, scrims, recordatorios) =====
# Tras una caída, un aviso vencido hace menos de estos segundos aún se envía; si pasó más, se descarta.
SCHEDULER_GRACE_SECONDS=300

# ===== Límite de uso de comandos =====
# Máximo de comandos por ventana (en segundos), por usuario y por grupo. El OWNER no está limitado.
RATE_LIMIT_USER_MAX=8
RATE_LIMIT_USER_WINDOW=10
RATE_LIMIT_GROUP_MAX=30
RATE_LIMIT_GROUP_WINDOW=10

# ===== Economía y XP (monedas virtuales, sin dinero real) =====
REGISTER_BONUS_COINS=100
REGISTER_BONUS_XP=50
ACTIVITY_XP=5
ACTIVITY_XP_COOLDOWN=60
